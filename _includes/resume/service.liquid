{% assign items = site.data.resume.service | default: [] %}
{% if items.size > 0 %}
<section id="service" class="resume-section">
  <h2 class="section-title">Service</h2>
  <div class="section-content">
    {% for it in items %}
      <div class="item">
        <div class="item-header">
          <span class="item-position">{{ it.position }}</span>
          {% if it.name %}<span class="item-org"> · {{ it.name }}</span>{% endif %}
          {% if it.startDate or it.endDate %}
            <span class="item-dates">
              — {{ it.startDate | default: '' }}{% if it.endDate %} – {{ it.endDate }}{% endif %}
            </span>
          {% endif %}
        </div>
        {% if it.summary %}<p class="item-summary">{{ it.summary }}</p>{% endif %}
        {% if it.highlights and it.highlights.size > 0 %}
          <ul class="item-highlights">
            {% for h in it.highlights %}
              <li>{{ h }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>
{% endif %}

