<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.linkedin_embed %}
                {% if item.title %}
                  <p class="mb-2">
                    <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                  </p>
                {% endif %}
                {% if include.preview %}
                  {% if item.content != blank %}
                    <div class="news-preview">{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</div>
                  {% endif %}
                  <a class="news-read-more" href="{{ item.url | relative_url }}">read more...</a>
                {% else %}
                  {% if item.content != blank %}
                    <div class="mb-2">{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</div>
                  {% endif %}
                  <div class="news-embed-wrapper">
                    <iframe
                      src="{{ item.linkedin_embed }}"
                      class="news-linkedin-embed"
                      height="{{ item.embed_height | default: 456 }}"
                      width="{{ item.embed_width | default: 504 }}"
                      frameborder="0"
                      scrolling="no"
                      allowfullscreen
                      title="{{ item.embed_title | default: item.title | default: 'Embedded LinkedIn post' | escape }}"
                    ></iframe>
                  </div>
                {% endif %}
              {% elsif item.inline %}
                {% if include.preview %}
                  <div class="news-preview">{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</div>
                  <a class="news-read-more" href="{{ item.url | relative_url }}">read more...</a>
                {% else %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% endif %}
              {% else %}
                {% if include.preview %}
                  <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                  {% if item.content != blank %}
                    <div class="news-preview">{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</div>
                  {% endif %}
                  <a class="news-read-more" href="{{ item.url | relative_url }}">read more...</a>
                {% else %}
                  <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% endif %}
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
