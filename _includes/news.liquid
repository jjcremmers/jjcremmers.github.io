<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.linkedin_embed %}
                {% if item.title %}
                  <p class="mb-2">
                    <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                  </p>
                {% endif %}
                {% if item.content != blank %}
                  <div class="mb-2">{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</div>
                {% endif %}
                <a class="news-embed-link" href="{{ item.url | relative_url }}" aria-label="Open {{ item.title | default: 'LinkedIn post' | escape }}">
                  <div class="news-embed-wrapper news-embed-wrapper-preview">
                    <iframe
                      src="{{ item.linkedin_embed }}"
                      class="news-linkedin-embed"
                      height="{{ item.embed_height | default: 456 }}"
                      width="{{ item.embed_width | default: 504 }}"
                      frameborder="0"
                      allowfullscreen
                      title="{{ item.embed_title | default: item.title | default: 'Embedded LinkedIn post' | escape }}"
                      tabindex="-1"
                    ></iframe>
                    <span class="news-embed-overlay"></span>
                  </div>
                </a>
              {% elsif item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
